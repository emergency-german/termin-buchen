generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Von mysql auf postgresql geändert
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  role     Role   @default(STAFF) // Nutzt jetzt das Enum unten
}

model Appointment {
  id        String   @id @default(cuid())
  name      String
  email     String
  date      DateTime
  createdAt DateTime @default(now())
}

enum Role {
  USER
  STAFF
  ADMIN
}
