generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // oder "postgresql"/"sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  role     String @default("STAFF")
}

model Appointment {
  id        String   @id @default(cuid())
  name      String
  email     String
  date      DateTime
  createdAt DateTime @default(now())
}


enum Role {
  USER
  STAFF
  ADMIN
}
