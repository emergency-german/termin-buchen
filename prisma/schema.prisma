generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // oder "postgresql"/"sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  password String
  role     Role    @default(USER)
  createdAt DateTime @default(now())
}

enum Role {
  USER
  STAFF
  ADMIN
}
